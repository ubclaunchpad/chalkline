# Template for the app's settings on the Azure test server. Never commit real values.
#
# On the server, the filled-in copies live in /opt/chalkline/ and only root can read
# them (chmod 600):
#   staging.env  ->  the Postgres container on the server
#   main.env     ->  the managed Azure Postgres (chalkline-main-db)
# Pass one to the app with: docker run --env-file /opt/chalkline/staging.env ...
# Ask Alan for database passwords privately; never paste them in issues or chat.

# Go server. Defaults to 8080 when unset.
PORT=8080

# Staging: the chalkline-db container on the server's "chalkline" Docker network.
DATABASE_URL=postgres://chalkline:<password>@chalkline-db:5432/chalkline?sslmode=disable

# Main: managed Azure Postgres. Only the server can reach it, and TLS is required.
# Uses the chalkline_app login, never the admin.
# DATABASE_URL=postgres://chalkline_app:<password>@chalkline-main-db.postgres.database.azure.com:5432/chalkline?sslmode=require

# Optional: how often edits are written to Postgres. Defaults are used when unset.
PERSIST_FLUSH_INTERVAL=250ms
PERSIST_CHECKPOINT_INTERVAL=30s
