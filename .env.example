# Copy to .env for local overrides. Never commit .env.

# Go server
PORT=8080

# Local Postgres from compose.yaml. Required by the server.
POSTGRES_USER=chalkline
POSTGRES_PASSWORD=chalkline
POSTGRES_DB=chalkline
POSTGRES_PORT=5432
DATABASE_URL=postgres://chalkline:chalkline@localhost:5432/chalkline?sslmode=disable

# Where the Vite dev server proxies /api and /ws
CHALKLINE_SERVER_URL=http://localhost:8080

# Positive durations: log flushing and dirty-board checkpointing.
PERSIST_FLUSH_INTERVAL=250ms
PERSIST_CHECKPOINT_INTERVAL=30s
